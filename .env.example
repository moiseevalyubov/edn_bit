APP_BASE_URL=https://your-server.com
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
BITRIX_CLIENT_ID=your_client_id
BITRIX_CLIENT_SECRET=your_client_secret
# Только исходящее Telegram из CRM; Открытые линии работают без этого параметра.
CRM_TELEGRAM_OUTREACH_ENABLED=0
